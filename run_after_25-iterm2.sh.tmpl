#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
# Point iTerm2 at the chezmoi-tracked prefs folder (~/.config/iterm2), so the
# plist managed in this repo is what iTerm2 loads. The plist itself lives at
# dot_config/iterm2/create_com.googlecode.iterm2.plist — `create_` so chezmoi
# seeds it on a fresh machine and then never rewrites it. iTerm2 saves changes
# automatically into that folder, so the live file always drifts (it also dumps
# inherited Apple* NSUserDefaults into it); tracking it strictly would mean
# endless `chezmoi status` noise and apply clobbering the running app's prefs.
#
# Plain run_, not run_once_: the branch below deliberately does nothing while
# iTerm2 is up, and a run_once_ script that exits 0 gets memoized — so a machine
# bootstrapped from inside iTerm2 would record the skip as done and never set the
# prefs at all. Running every apply costs two `defaults write` calls and lets it
# fix itself the first time an apply happens with iTerm2 closed.
set -euo pipefail

PREFS_DIR="$HOME/.config/iterm2"

# Already pointed at the right folder? Nothing to do, and nothing to say about it —
# this runs on every apply now, so the common case has to be silent.
if [ "$(defaults read com.googlecode.iterm2 PrefsCustomFolder 2>/dev/null || true)" = "$PREFS_DIR" ] \
   && [ "$(defaults read com.googlecode.iterm2 LoadPrefsFromCustomFolder 2>/dev/null || true)" = "1" ]; then
  exit 0
fi

# `pgrep iTerm2` does not work here: pgrep cannot see the running app at all on
# macOS (it happily matches other GUI apps such as Finder, but never iTerm2, with
# or without -x/-f). The old guard therefore always took the "not running" branch
# and wrote prefs underneath a live app. `ps` does see it — `-Ac` prints the bare
# command name, padded, so trim the trailing blanks before an anchored match.
iterm2_is_running() {
  ps -Ac -o comm= | sed 's/ *$//' | grep -Fqx iTerm2
}

# Setting these via `defaults write` while iTerm2 is running is unsafe: on quit
# iTerm2 flushes its in-memory prefs and clobbers the change. Only write when
# it isn't running; otherwise tell the user to flip the toggle in-app.
if iterm2_is_running; then
  echo "iTerm2 is running — not touching its prefs to avoid a write race."
  echo "Enable it in-app: Settings → General → Settings →"
  echo "  ‘Load preferences from a custom folder or URL’ → $PREFS_DIR"
  echo "  and set ‘Save changes’ to ‘Automatically’."
  echo "Do NOT click ‘Save Current Settings to Folder’ — that overwrites the"
  echo "  chezmoi-tracked plist in $PREFS_DIR with this machine's stock prefs."
else
  defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$PREFS_DIR"
  defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
  echo "iTerm2 set to load prefs from $PREFS_DIR (takes effect on next launch)."
fi
{{- else }}
# iTerm2 is macOS-only — nothing to do here.
{{- end }}
