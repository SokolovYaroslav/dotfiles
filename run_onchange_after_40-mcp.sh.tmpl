#!/usr/bin/env bash
{{- if .enableMcp }}
# Register the YouTrack MCP server at user scope over plain HTTP. No secret is involved:
# youtrack.jetbrains.com/mcp is an OAuth 2.1 protected resource (it answers an unauthenticated
# request with a WWW-Authenticate challenge pointing at hub.jetbrains.com), and Claude Code
# registers itself through a Client ID Metadata Document rather than Dynamic Client
# Registration — which YouTrack does not support. Authorization is therefore a one-time
# browser sign-in per machine; Claude Code stores the access and refresh tokens in its own
# credential store (macOS Keychain) and refreshes them silently from then on.
#
# This replaced a stdio bridge (`op run` -> sh -> uvx mcp-proxy) that injected a permanent
# token. It worked interactively, but every launch depended on the 1Password desktop app
# being unlocked at that moment: unattended eval runs blocked on a biometric prompt nobody
# was there to answer and died on Claude's 30s MCP connect timeout with no stderr at all.
# HTTP transport removes the child process entirely, so there is nothing left that can
# prompt — and no permanent token stored anywhere.
set -euo pipefail

URL="https://youtrack.jetbrains.com/mcp"

if ! command -v claude >/dev/null 2>&1; then
  echo "claude CLI not found — skipping YouTrack MCP registration."
  exit 0
fi

# Never remove-and-re-add a server that is already correct: that discards the stored OAuth
# grant and forces another browser sign-in. Only the old stdio registration gets replaced.
if claude mcp get youtrack >/dev/null 2>&1; then
  if claude mcp get youtrack 2>/dev/null | grep -q "Type: http"; then
    echo "YouTrack MCP already registered over HTTP — leaving it and its OAuth login alone."
    exit 0
  fi
  echo "Replacing the old stdio YouTrack MCP registration with the HTTP/OAuth one…"
  claude mcp remove youtrack -s user >/dev/null 2>&1 || true
fi

claude mcp add --transport http --scope user youtrack "$URL"
echo "Registered YouTrack MCP at $URL."
echo "Authorize it once with: claude mcp login youtrack"
{{- else }}
# YouTrack MCP registration skipped (enableMcp = false)
{{- end }}
