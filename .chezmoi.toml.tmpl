{{- /* Wizard prompts. Answers are stored in chezmoi's persistent state and asked only once. */ -}}
{{- $opAccount := promptStringOnce . "opAccount" "1Password account shorthand (e.g. my.1password.com)" -}}
{{- $useOpSsh := promptBoolOnce . "useOnePasswordSshAgent" "Use the 1Password SSH agent (also used for git commit signing)?" -}}
{{- $enableJbProxy := promptBoolOnce . "enableJbProxy" "Install & wire the JetBrains AI proxy via central (installs, logs in, runs 'central add claude-code' to route Claude through it)?" -}}
{{- $installGh := promptBoolOnce . "installGh" "Install the GitHub CLI (gh) and run 'gh auth login'?" -}}
{{- $enableMcp := promptBoolOnce . "enableMcp" "Register the YouTrack MCP server for Claude Code?" -}}
{{- $installSkills := promptBoolOnce . "installSkills" "Install my global Claude Code skills (from my private claude-skills repo)?" -}}
{{- $installAuthorizedKeys := promptBoolOnce . "installAuthorizedKeys" "Provision ~/.ssh/authorized_keys from 1Password so this machine accepts SSH logins with your key?" -}}

{{/* oh-my-zsh and zsh-autosuggestions are archive externals on a weekly refresh.
     Every refresh reports dozens of upstream file changes that are never ours to
     review, which buries our own drift in noise. Hide externals from status and
     diff so those commands only report what we actually manage; `chezmoi apply`
     still refreshes them as before. To look on purpose: --exclude=none. */}}
[status]
    exclude = ["externals"]

[diff]
    exclude = ["externals"]

[data]
    opAccount = {{ $opAccount | quote }}
    useOnePasswordSshAgent = {{ $useOpSsh }}
    enableJbProxy = {{ $enableJbProxy }}
    installGh = {{ $installGh }}
    enableMcp = {{ $enableMcp }}
    installSkills = {{ $installSkills }}
    installAuthorizedKeys = {{ $installAuthorizedKeys }}
