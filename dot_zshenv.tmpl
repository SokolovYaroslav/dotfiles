# Rust/Cargo env, if present.
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

# PATH lives here rather than in ~/.zshrc so that *every* zsh gets it, not just
# interactive ones: `zsh -c`, ssh commands, and IDE-spawned shells all read this
# file and nothing else. Claude Code and central install into ~/.local/bin, and
# while that directory was added by ~/.zshrc alone, anything non-interactive
# concluded those binaries did not exist. On a fresh machine that included the
# bootstrap shell itself, so chezmoi's own run_ scripts inherited a PATH without
# it — which is how the YouTrack MCP server went unregistered while `claude` sat
# installed in ~/.local/bin (see run_onchange_after_40-mcp.sh.tmpl).
#
# `typeset -U` keeps `path` deduplicated, so re-prepending an entry later moves it
# to the front instead of appending a second copy.
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/bin" $path)

# YouTrack REST API base URL. Not a secret, so it is set unconditionally. There is
# deliberately no token here: the YouTrack MCP server authenticates over OAuth (see
# run_onchange_after_40-mcp.sh.tmpl), and ad-hoc REST calls can pull a token when they
# actually need one with `op item get 'YT Token' --reveal`.
export YOUTRACK_BASE_URL="https://youtrack.jetbrains.com"

# No secrets are resolved from 1Password at any point in the shell. This file used to
# define yt_token / yt_auth / anthropic_key wrappers around `op item get`; they were
# dropped because nothing referenced them and every `op` call risks a biometric prompt
# that only a human at the keyboard can answer.
#
# Claude Code needs no secret injection at launch either: the YouTrack MCP server is a
# plain HTTP server that authorizes over OAuth and keeps its tokens in Claude's own
# credential store. So `claude` is invoked as the plain binary, and behaves identically
# whether it is launched from this shell, the IDE's Agent Workbench, or an unattended
# batch run. Proxy routing is baked into ~/.claude/settings.json by `central add
# claude-code`.

# Machine-specific overrides (not tracked by chezmoi).
if [ -f "$HOME/.zshenv.local" ]; then
    source "$HOME/.zshenv.local"
fi

# Langfuse agent tracing (personal opt-in; overrides agent/app/.env under uv run --env-file)
export LANGFUSE_TRACING=true
export LANGFUSE_TRACING_ENVIRONMENT=yas
